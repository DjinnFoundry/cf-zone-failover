{
  "name": "cf-zone-failover",
  "version": "0.2.3",
  "description": "Keep sites on Cloudflare up when ISPs block their zones' IPs: a reserve proxy on another zone, and a guard that switches each site's DNS to it and back.",
  "license": "MIT",
  "author": "Djinn Foundry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DjinnFoundry/cf-zone-failover.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard-worker": {
      "types": "./dist/guard-worker.d.ts",
      "default": "./dist/guard-worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist",
    "leaks": "node scripts/public-data.mjs --authors"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "failover",
    "dns",
    "isp-blocking",
    "cloudflare-for-saas"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
